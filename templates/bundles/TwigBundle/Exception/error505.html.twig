{% extends 'base.html.twig' %}

{% block title %}Page non trouvée{% endblock %}

{% block body %}
    <div class="container text-center mt-5">
        <h1 class="display-4">505</h1>
        <p class="lead">Version HTTP non supportée.</p>
        <p>Il semble que la version de votre navigateur ou de votre client HTTP ne soit pas compatible avec nos serveurs.</p>
        
        <div class="mt-4">
            <a href="{{ path('home') }}" class="btn btn-primary">Retour à l'accueil</a>            
        </div>
        
        <div class="mt-3">
            <p class="small text-muted">Si le problème persiste, contactez notre équipe de support technique.</p>
        </div>
    </div>
{% endblock %}