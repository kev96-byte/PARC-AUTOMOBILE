{% extends 'base.html.twig' %}

{% block mycontent %}
<div class="col-12 card-body">
    <div class="card card-content-template">
        <h5>Liste des Véhicules</h5>
        
        <!-- Toolbar -->
        <div class="p-toolbar p-component mb-4" role="toolbar">
            <div class="p-toolbar-group-left">
                <a href="{{ path('vehicule.create') }}">
                    <button class="p-button p-component p-button-success">
                        <span class="p-button-icon p-c p-button-icon-left fa fa-plus"></span>
                        <span class="p-button-label p-c">Nouveau</span>
                    </button>
                </a>
            </div>
        </div>
        
        <!-- Table -->
        <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Immatriculation</th>
                    <th>Marque</th>
                    <th>Modèle</th>
                    <th>Nombre de places</th>
                    <th>État</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for vehicule in vehicules %}
                    <tr>
                        <td>{{ vehicule.matricule }}</td>
                        <td>{{ vehicule.marque.libelleMarque }}</td>
                        <td>{{ vehicule.modele }}</td>
                        <td>{{ vehicule.nbrePlace }}</td>
                        <td>{{ vehicule.etat }}</td>
                        <td>
                            <a href="{{ path('vehicule.show', {'id': vehicule.id}) }}" class="text-decoration-none mr-3">
                                <img src="{{ asset('img/icons/details.svg') }}" alt="Détails" style="width: 1.3em;"/>
                            </a>
                            <a href="{{ path('vehicule.edit', {'id': vehicule.id}) }}" class="text-decoration-none mr-3">
                                <img src="{{ asset('img/icons/edit.svg') }}" alt="Modifier" style="width: 1.3em;"/>
                            </a>
                            <a href="#" class="text-decoration-none" onclick="showDeletionModal(this);" 
                               data-id="{{ vehicule.id }}" data-token="{{ csrf_token('delete' ~ vehicule.id) }}">
                                <img src="{{ asset('img/icons/trash.svg') }}" alt="Supprimer" style="width: 1.3em;"/>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <!-- Modal de confirmation -->
        {% include 'vehicule/_modale_delete.html.twig' %}
    </div>
</div>

<script>
    // Fonction pour afficher le modal de suppression
    function showDeletionModal(element) {
        var vehiculeId = element.getAttribute('data-id');
        var csrfToken = element.getAttribute('data-token');

        // Mettre à jour les champs cachés du modal
        document.getElementById('modal_token').value = csrfToken;
        document.getElementById('modal_vehicule_id').value = vehiculeId;

        // Mettre à jour l'action du formulaire
        document.getElementById('modalDeleteForm').action = '{{ path("vehicule.delete", {"id": "__ID__"}) }}'.replace('__ID__', vehiculeId);

        // Afficher le modal
        $('#confirmModal').modal('show');
    }

    document.addEventListener('DOMContentLoaded', function () {
        var confirmButton = document.getElementById('confirmButton');
        if (confirmButton) {
            confirmButton.addEventListener('click', function () {
                document.getElementById('modalDeleteForm').submit();
            });
        }
    });
</script>
{% endblock %}
