{% extends 'base.html.twig' %}

{% block mycontent %}
<div class="col-12 card-body">
    <div class="card card-content-template">
        <h5>Assurance des véhicules</h5>
        
        <!-- Barre d'outils -->
        <div class="p-toolbar p-component mb-4" role="toolbar">
            <div class="p-toolbar-group-left">
                <a href="{{ path('assurance.create') }}">
                    <button class="p-button p-component p-button-success mr-2">
                        <span class="p-button-icon p-c p-button-icon-left fa fa-plus"></span>
                        <span class="p-button-label p-c">Nouveau</span>
                    </button>
                </a>
            </div>
        </div>
        
        <!-- Tableau -->
        <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Matricule</th>
                    <th>Date début assurance</th>
                    <th>Date fin assurance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for assurance in assurances %}
                    <tr>
                        <td>{{ assurance.vehicule.matricule }}</td>
                        <td>{{ assurance.dateDebutAssurance ? assurance.dateDebutAssurance|date('d-m-Y') : '' }}</td>
                        <td>{{ assurance.dateFinAssurance ? assurance.dateFinAssurance|date('d-m-Y') : '' }}</td>
                        <td>
                            <div class="d-flex justify-content-end">
                                <a href="{{ path('assurance.edit', {'id': assurance.id}) }}" class="text-decoration-none mr-3">
                                    <img src="{{ asset('img/icons/edit.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                </a>
                                <a href="{{ asset('img/Assurances/' ~ assurance.pieceAssurance) }}" class="text-decoration-none mr-3" download>
                                    <img src="{{ asset('img/icons/download.svg') }}" alt="Télécharger" style="width: 1.3em;" />
                                </a>
                                <a href="#" class="text-decoration-none" 
                                   data-id="{{ assurance.id }}" 
                                   data-token="{{ csrf_token('delete' ~ assurance.id) }}" 
                                   onclick="showDeletionModal(this)">
                                    <img src="{{ asset('img/icons/trash.svg') }}" alt="Supprimer" style="width: 1.3em;" />
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer cette assurance ?
                <form id="modalDeleteForm" method="post">
                    <input type="hidden" name="_token" id="modal_token" value="">
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non</button>
                <button type="button" class="btn btn-primary" id="confirmButton">Oui</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showDeletionModal(element) {
        var assuranceId = element.getAttribute('data-id');
        var csrfToken = element.getAttribute('data-token');

        // Mise à jour des champs cachés dans le modal
        document.getElementById('modal_token').value = csrfToken;

        // Mise à jour de l'action du formulaire avec l'ID de l'assurance
        document.getElementById('modalDeleteForm').action = '{{ path("assurance.delete", {"id": "__ID__"}) }}'.replace('__ID__', assuranceId);

        // Afficher le modal de confirmation
        var confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
        confirmModal.show();
    }

    document.addEventListener('DOMContentLoaded', function () {
        var confirmButton = document.getElementById('confirmButton');

        confirmButton.addEventListener('click', function () {
            // Soumettre le formulaire de suppression dans le modal
            document.getElementById('modalDeleteForm').submit();
        });
    });
</script>
{% endblock %}
