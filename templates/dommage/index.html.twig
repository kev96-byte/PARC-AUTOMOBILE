{% extends 'base.html.twig' %}

{% block mycontent %}
<div class="col-12 card-body">
    <div class="card card-content-template">
        <h5>Liste des dommages</h5>
        <div class="p-toolbar p-component mb-4" role="toolbar">
            <div class="p-toolbar-group-left">
                <div class="my-2">
                    <a href="{{ path('dommage.create') }}">
                        <button class="p-button p-component p-button-success mr-2">
                            <span class="p-button-icon p-c p-button-icon-left fa fa-plus"></span>
                            <span class="p-button-label p-c">Nouveau</span>
                            <span class="p-ink"></span>
                        </button>
                    </a>
                    
                    <!-- Nouveau bouton pour afficher les véhicules réparés -->
                    <a href="{{ path('vehicules.repares') }}"> 
                        <button class="p-button p-component p-button-info">
                            <span class="p-button-icon p-c p-button-icon-left fa fa-car"></span>
                            <span class="p-button-label p-c">Véhicules Réparés</span>
                            <span class="p-ink"></span>
                        </button>
                    </a>
                </div>
            </div>
        </div>

        <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Véhicule</th>
                    <th>Chauffeur</th>
                    <th>Type de Dommage</th>
                    <th>Description</th>
                    <th>Date de l'incident</th>
                    <th>Actions</th>
                    <th>Réparations</th>
                </tr>
            </thead>
            <tbody>
                {% for dommage in dommages %}
                    <tr>
                        <td>{{ dommage.vehicule.matricule }}</td>
                        <td>
                            {% if dommage.chauffeur %}
                                {{ dommage.chauffeur.nomChauffeur }} {{ dommage.chauffeur.prenomChauffeur }}
                            {% else %}
                                Aucun
                            {% endif %}
                        </td>
                        <td>{{ dommage.typeDommage }}</td>
                        <td>{{ dommage.description | slice(0, 50) ~ '...' }}</td> {# Affiche les 50 premiers caractères de la description #}
                        <td>{{ dommage.dateDommage ? dommage.dateDommage|date('d/m/Y H:i') : 'N/A' }}</td>
                        <td>
                            <div class="d-flex">
                                <a href="{{ path('dommage.show', {'id': dommage.id}) }}" class="text-decoration-none mr-3">
                                    <img src="{{ asset('img/icons/details.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                </a> 
                                <a href="{{ path('dommage.edit', {'id': dommage.id}) }}" class="text-decoration-none mr-3">
                                    <img src="{{ asset('img/icons/edit.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                </a>
                                <a href="#" class="text-decoration-none" onclick="showDeletionModal(this);" data-id="{{ dommage.id }}" data-token="{{ csrf_token('delete' ~ dommage.id) }}">
                                    <img src="{{ asset('img/icons/trash.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                </a>   
                            </div>
                            {# <div class="button-group open">
                                <button class="btn btn-xs btn-default dropdown-toggle" title="Cliquez ici pour effectuer une action" type="button" data-toggle="dropdown" aria-expanded="true">
                                    <i class="fa fa-ellipsis-h" style="color: #777;"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-right"> #}
                                    {# <li class="p-2">
                                        <a href="{{ path('dommage.show', {'id': dommage.id}) }}" class="text-decoration-none">
                                            <img src="{{ asset('img/icons/details.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                            <button class="btn btn-sm btn-circle rounded-circle" style="color: white; background-color: #22C552; width: 30px; height: 30px;">
                                                <i class="fas fa-low-vision"></i>
                                            </button>
                                            <span style="color: #777;">&nbsp; Voir détails</span>
                                        </a> 
                                    </li> #}
                                    {# <li class="p-2">
                                        <a href="{{ path('dommage.edit', {'id': dommage.id}) }}" class="text-decoration-none">
                                            <img src="{{ asset('img/icons/edit.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                            <button class="btn btn-sm btn-circle rounded-circle" style="color: white; background-color: #f59e0B; width: 30px; height: 30px;">
                                                <i class="fa fa-pen"></i>
                                            </button>
                                            <span style="color: #777;">&nbsp; Modifier</span>
                                        </a>    
                                    </li> #}
                                    {# <li class="p-2">
                                        <a href="#" class="text-decoration-none" onclick="showDeletionModal(this);" data-id="{{ dommage.id }}" data-token="{{ csrf_token('delete' ~ dommage.id) }}">
                                            <img src="{{ asset('img/icons/trash.svg') }}" alt="Modifier" style="width: 1.3em;" />
                                            <button type="button" class="btn btn-sm btn-circle rounded-circle" style="color: white; background-color: hsl(0, 92%, 50%); width: 30px; height: 30px;">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                            <span style="color: #777;">&nbsp; Supprimer</span>
                                        </a>
                                    </li> #}
                                {# </ul> #}
                            {# </div> #}
                        </td>
                        <td>
                            {% if dommage.repare %}
                                <span class="badge bg-success">Réparé</span>
                            {% else %}
                                <a href="{{ path('dommage.reparer', {'id': dommage.id}) }}" class="text-decoration-none">
                                    <button class="btn btn-sm btn-circle rounded-circle" style="color: white; background-color: #4CAF50; width: 30px; height: 30px;">
                                        <i class="fa fa-wrench"></i>
                                    </button>
                                    <span style="color: #777;">&nbsp; Marquer comme réparé</span>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Aucun dommage enregistré</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer ce dommage ?
                <form id="modalDeleteForm" method="post">
                    <input type="hidden" name="_token" id="modal_token" value="">
                    <input type="hidden" name="dommage_id" id="modal_dommage_id" value="">
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non</button>
                <button type="button" class="btn btn-primary" id="confirmButton">Oui</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showDeletionModal(element) {
        var dommageId = element.getAttribute('data-id');
        var csrfToken = element.getAttribute('data-token');

        document.getElementById('modal_token').value = csrfToken;
        document.getElementById('modal_dommage_id').value = dommageId;

        document.getElementById('modalDeleteForm').action = '{{ path("dommage.delete", {"id": "__ID__"}) }}'.replace('__ID__', dommageId);
        $('#confirmModal').modal('show');
    }

    document.addEventListener('DOMContentLoaded', function () {
        var confirmButton = document.getElementById('confirmButton');

        confirmButton.addEventListener('click', function () {
            document.getElementById('modalDeleteForm').submit();
        });
    });
</script>
{% endblock %}
