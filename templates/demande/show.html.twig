{# templates/demande/show.html.twig #}
{% extends 'base.html.twig' %}

{% block mycontent %}
<div class="col-12 card-body">
    <div class="card" style="min-height: 475px;">
        <h5>Details demande</h5>
        
        {# Bouton Retour #}
        <div class="p-toolbar p-component mb-4" role="toolbar">
            <div class="p-toolbar-group-left">
                <div class="my-2">
                    <a href="javascript:history.back()">
                        <button class="p-button p-component p-button-outlined mr-2">
                            <span class="p-button-icon p-c p-button-icon-left fa fa-arrow-left"></span>
                            <span class="p-button-label p-c">Retour à la liste</span>
                            <span class="p-ink"></span>
                        </button>
                    </a>
                </div>
            </div>
        </div>

        {# Tableau des détails #}
        <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
            <tbody>
                {# Informations de base #}
                <tr>
                    <th>Numéro demande</th>
                    <td>{{ demande.numDemande }}</td>
                </tr>
                <tr>
                    <th>Date Demande</th>
                    <td>{{ demande.dateDemande|format_date('d/m/Y H:i:s') }}</td>
                </tr>
                <tr>
                    <th>Référence note de service</th>
                    <td>{{ demande.referenceNoteDeService }}</td>
                </tr>
                <tr>
                    <th>Objet mission</th>
                    <td>{{ demande.objetMission }}</td>
                </tr>
                <tr>
                    <th>Date début mission</th>
                    <td>{{ demande.dateDebutMission|date("d/m/Y") }}</td>
                </tr>
                <tr>
                    <th>Date fin mission</th>
                    <td>{{ demande.dateFinMission|date("d/m/Y") }}</td>
                </tr>

                {# Date annulation si applicable #}
                {% if demande.statut == 'Annulé' %}
                    <tr>
                        <th>Date annulation mission</th>
                        <td>{{ demande.cancellationDate|date("d/m/Y") }}</td>
                    </tr>
                {% endif %}

                {# Lieu et participants #}
                <tr>
                    <th>Lieu Mission</th>
                    <td>
                        <ul>
                            {% for value in demande.lieuMission %}
                                <li>{{ value|upper }}</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
                <tr>
                    <th>Nombre de participants</th>
                    <td>{{ demande.nbreParticipants }}</td>
                </tr>
                <tr>
                    <th>Nombre de véhicules</th>
                    <td>{{ demande.nbreVehicules }}</td>
                </tr>

                {# Véhicules et chauffeurs si assignés #}
                {% if demande.vehicules is not empty %}
                    <tr>
                        <th>Véhicules choisis</th>
                        <td>
                            <ul>
                                {% for value in demande.vehicules %}
                                    <li>{{ value|upper }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endif %}

                {% if demande.chauffeurs is not empty %}
                    <tr>
                        <th>Chauffeurs choisis</th>
                        <td>
                            <ul>
                                {% for chauffeur in chauffeurs %}
                                    <li>
                                        {{ chauffeur.matriculeChauffeur }} - {{ chauffeur.nomChauffeur|upper }} {{ chauffeur.prenomChauffeur }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endif %}

                {# Informations utilisateurs #}
                <tr>
                    <th>Point focal (Demandeur)</th>
                    <td>
                        {{ demande.demander.lastName }} {{ demande.demander.firstName }}
                    </td>
                </tr>

                {% if demande.statut == 'Approuvé' or demande.statut == 'Traité' or (demande.statut == 'Rejeté' and demande.validateurStructure is not empty) %}
                    <tr>
                        <th>Responsable structure (Approbateur)</th>
                        <td>
                            {{ demande.validateurStructure.lastName }} {{ demande.validateurStructure.firstName }}
                        </td>
                    </tr>
                {% endif %}

                {% if demande.traiterPar is not empty %}
                    <tr>
                        <th>Chef parc</th>
                        <td>
                            {{ demande.traiterPar.lastName }} {{ demande.traiterPar.firstName }}
                        </td>
                    </tr>
                {% endif %}

                {# Statut et raisons #}
                <tr>
                    <th>Statut demande</th>
                    <td>
                        <span class="badge {% if demande.statut == 'Initial' %}bg-secondary
                            {% elseif demande.statut == 'Approuvé' %}badge badge-primary
                            {% elseif demande.statut == 'Validé' %}badge badge-success
                            {% elseif demande.statut == 'Traité' %}badge badge-info
                            {% elseif demande.statut == 'Rejeté' %}badge badge-danger
                            {% else %}badge badge-warning{% endif %}">
                            {{ demande.statut }}
                        </span>
                    </td>
                </tr>

                {% if demande.statut == 'Rejeté' %}
                    <tr>
                        <th>Raison rejet</th>
                        <td>{{ demande.raisonRejetApprobation }}</td>
                    </tr>
                {% endif %}

                {% if demande.statut == 'Annulé' %}
                    <tr>
                        <th>Raison annulation</th>
                        <td>{{ demande.cancellationReason }}</td>
                    </tr>
                {% endif %}

                {% if demande.observations is not empty %}
                    <tr>
                        <th>Commentaire</th>
                        <td>{{ demande.observations }}</td>
                    </tr>
                {% endif %}

                {# Boutons d'action selon le rôle #}
                {% if is_granted('ROLE_RESPONSABLE_STRUCTURE') and not is_granted('ROLE_ADMIN') and demande.statut == 'Initial' %}
                    <tr>
                        <td colspan="2">
                            <div class="d-flex justify-content-center mt-4">
                                <button type="button" class="btn btn-success mx-2" data-bs-toggle="modal" data-bs-target="#approveModal">
                                    Approuver
                                </button>
                                <button type="button" class="btn btn-danger mx-2" data-bs-toggle="modal" data-bs-target="#rejectionModal">
                                    Rejeter
                                </button>
                                <button type="button" class="btn btn-warning mx-2" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                    Annuler
                                </button>
                            </div>
                        </td>
                    </tr>
                {% endif %}

                {% if is_granted('ROLE_CHEF_PARC') and not is_granted('ROLE_ADMIN') and demande.statut == 'Approuvé' %}
                    <tr>
                        <td colspan="2">
                            <div class="d-flex justify-content-center mt-4">
                                <a href="{{ path('affecter.create', {'demandeId': demande.id}) }}" class="btn btn-primary mx-2">
                                    Traiter
                                </a>
                                <button type="button" class="btn btn-danger mx-2" data-bs-toggle="modal" data-bs-target="#rejectionModal">
                                    Rejeter
                                </button>
                            </div>
                        </td>
                    </tr>
                {% endif %}

                {% if is_granted('ROLE_VALIDATEUR') and not is_granted('ROLE_ADMIN') and demande.statut == 'Traité' %}
                    <tr>
                        <td colspan="2">
                            <div class="d-flex justify-content-center mt-4">
                                <a href="{{ path('demande_valider', {'id': demande.id}) }}" class="btn btn-primary mx-2" data-bs-toggle="modal" data-bs-target="#validateModal">
                                    Valider
                                </a>
                                <button type="button" class="btn btn-danger mx-2" data-bs-toggle="modal" data-bs-target="#rejectionModal">
                                    Rejeter
                                </button>
                            </div>
                        </td>
                    </tr>
                {% endif %}
                {% if is_granted('ROLE_VALIDATEUR') and not is_granted('ROLE_ADMIN') and demande.statut == 'Validé' and demande.canceledRequest is not empty %}
                    <tr>
                        <td colspan="2">
                            <div class="d-flex justify-content-center mt-4">
                                <form action="{{ path('affecter.process_cancellation', {'id': demande.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette demande ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ demande.id) }}">
                                    <button type="submit" class="btn btn-warning mx-2">Annuler la demande</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endif %}
                {% if is_granted('ROLE_RESPONSABLE_STRUCTURE') and demande.validateurStructure == app.user and not is_granted('ROLE_ADMIN') and demande.statut == 'Validé' and demande.canceledRequest is null %}
                    <tr>
                        <td colspan="2">
                            <div class="d-flex justify-content-center mt-4">
                                {# <a href="{{path('demande.request_cancellation', {'id':demande.id})}}" class="btn btn-warning mx-2" data-bs-toggle="modal" data-bs-target="#requestCancellationModal">
                                    Demande d'annulation
                                </a> #}
                                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#requestCancellationModal">
                                    Demander l'annulation
                                </button>
                            </div>
                        </td>
                    </tr>
                {%endif%}
            </tbody>
        </table>
    </div>
    
    {% if demande.statut == 'Validé' or demande.statut == 'Traité' and details is not empty %}
        <div class="card">
            <tr>
                <td colspan="2">
                    <div class="shadow-sm p-3 mb-5 bg-white rounded">
                        <hr class="my-4 border-primary">
                    </div>
                    <div class="table-responsive">
                        <h5><b>Véhicule (s) et chauffeur(s) affecté(s)</b></h5>
                        <table class="table table-bordered table-striped " id="dataTable" cellspacing="0">
                            <thead>
                            <tr>
                                <th>Matricule</th>
                                <th>Voir véhicule</th>
                                <th>Nom et prénom chauffeur</th>
                                <th>Voir chauffeur</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for detail in details %}

                                <tr>
                                    <td>{{ detail.matricule }}</td>

                                    <td>                            
                                        <a target="_blank" href="{{ asset('img/Vehicules/' ~ detail.photoVehicule) }}">
                                            <button class="btn btn-sm btn-circle rounded-circle mr-2" style="color: white; background-color: #22C552;">
                                                <i class="fa fa-download"></i>
                                            </button>
                                        </a>  
                                    </td>


                                    <td>{{ detail.nomChauffeur }} {{ detail.prenomChauffeur }}</td>
                                    <td>
                                        <a target="_blank" href="{{ asset('img/Chauffeurs/' ~ detail.photoChauffeur) }}">
                                            <button class="btn btn-sm btn-circle rounded-circle mr-2" style="color: white; background-color: #22C552;">
                                                <i class="fa fa-download"></i>
                                            </button>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                </td>
            </tr>
        </div>
    {% endif %}
    
</div>

    {# Modals #}
    {% include 'demande/_modal_reject.html.twig' %}
    {% include 'demande/_modal_approve.html.twig' %}
    {% include 'demande/_modal_cancel.html.twig' %}
    {% include 'demande/_modal_validate.html.twig' %}
    {% include 'demande/_modal_request_cancellation.html.twig' %}
    {% include 'demande/_modal_confirmation_cancellation.html.twig'%}
{% endblock %}

