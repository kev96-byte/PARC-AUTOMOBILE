{% extends 'base.html.twig' %}

{% block mycontent %}
    <div class="col-12 card-body tablestyle">
        <div class="card" style="min-height: 475px;">
            <h5>Liste des demandes</h5>
            
            {% if is_granted('ROLE_POINT_FOCAL') %}
                <div class="p-toolbar p-component mb-4" role="toolbar">
                    <div class="p-toolbar-group-left">
                        <div class="my-2">
                            <a href="{{ path('demande.create') }}" class="btn btn-success">
                                <i class="fa fa-plus mr-2"></i>
                                Nouveau
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
            
            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="dataTable" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Numéro demande</th>
                            <th>Date de demande</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Lieu</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="7">Aucun enregistrement trouvé</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr>
                                    <td>{{ demande.numDemande }}</td>
                                    <td>{{ demande.dateDemande|date("d/m/Y") }}</td>
                                    <td>{{ demande.dateDebutMission|date("d/m/Y") }}</td>
                                    <td>{{ demande.dateFinMission|date("d/m/Y") }}</td>
                                    <td>
                                        <ul class="list-unstyled m-0">
                                            {% for value in demande.lieuMission %}
                                                <li>{{ value|upper }}</li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if demande.statut == 'Initial' %}badge-light
                                            {% elseif demande.statut == 'Approuvé' %}badge badge-primary
                                            {% elseif demande.statut == 'Validé' %}badge badge-success
                                            {% elseif demande.statut == 'Traité' %}badge badge-info
                                            {% elseif demande.statut == 'Rejeté' %}badge badge-danger
                                            {% else %}badge-secondary
                                            {% endif %}">
                                            {{ demande.statut }}
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <div class="d-flex justify-content-end">
                                            <a href="{{ path('demande.show', {'id': demande.id}) }}" class="text-decoration-none mr-3" title="Détails">
                                                <img src="{{ asset('img/icons/details.svg') }}" alt="Détails" style="width: 1.3em;"/>
                                            </a>

                                            {% if is_granted('ROLE_POINT_FOCAL') and not is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('demande.edit', {'id': demande.id}) }}" class="text-decoration-none mr-3" title="Modifier">
                                                    <img src="{{ asset('img/icons/edit.svg') }}" alt="Modifier" style="width: 1.3em;"/>
                                                </a>
                                                <a href="#" class="open-cancel-modal mr-3" data-id="{{ demande.id }}" data-bs-toggle="modal" data-bs-target="#cancelModal" title="Annuler">
                                                    <img src="{{ asset('img/icons/canceled.svg') }}" alt="Annuler" style="width: 1.3em;"/>
                                                </a>
                                            {% endif %}

                                            {% if demande.statut == 'Validé' %}
                                                <a href="{{ path('demande.etat', {'id': demande.id}) }}" title="Imprimer">
                                                    <img src="{{ asset('img/icons/impression.svg') }}" alt="Imprimer" style="width: 1.3em;"/>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal pour la saisie de la raison d'annulation -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelModalLabel">Raison de l'annulation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="cancelForm" method="POST" action="">
                        <div class="mb-3">
                            <label for="cancelReason" class="form-label">Raison :</label>
                            <textarea class="form-control" id="cancelReason" name="reason" rows="3" required></textarea>
                        </div>
                        <input type="hidden" name="demande_id" id="demandeId">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-primary" form="cancelForm">Confirmer l'annulation</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const cancelButtons = document.querySelectorAll('.open-cancel-modal');
            
            cancelButtons.forEach(button => {
                button.addEventListener('click', function(event) {
                    event.preventDefault(); // Empêche la navigation par défaut
                    const demandeId = this.getAttribute('data-id');
                    const cancelForm = document.getElementById('cancelForm');
                    
                    // Mise à jour du champ caché avec l'ID de la demande
                    document.getElementById('demandeId').value = demandeId;
                    
                    // Mise à jour dynamique de l'action du formulaire
                    cancelForm.action = "{{ path('demande.cancel', {'id': '__id__'}) }}".replace('__id__', demandeId);
                });
            });
        });
    </script>
{% endblock %}