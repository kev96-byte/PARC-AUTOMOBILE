{# templates/demande/_modal_approve.html.twig #}
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="{{ path('demande.approve', {'id': demande.id}) }}" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title" id="approveModalLabel">Confirmation d'approbation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('approve') }}">
                    <p>Êtes-vous sûr de vouloir approuver cette demande ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success">Confirmer l'approbation</button>
                </div>
            </form>
        </div>
    </div>
</div>